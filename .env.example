# ---- Application ----
APP_ENV=development
APP_NAME=Labor Evidence Organizer
# Secret used to sign access tokens. MUST be replaced in production.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
# Development / CI default (native PostgreSQL installed on the host).
DATABASE_URL=postgresql+psycopg://leo:leo_dev_pw@127.0.0.1:5432/labor_evidence
# Used by pytest; points at an isolated database so tests never touch dev data.
TEST_DATABASE_URL=postgresql+psycopg://leo:leo_dev_pw@127.0.0.1:5432/labor_evidence_test
DB_ECHO=false

# ---- Object storage ----
# "local" writes to STORAGE_LOCAL_ROOT. "s3" is the production target and
# reads the S3_* variables below (S3-compatible endpoints supported).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---- Upload limits ----
# docs/03_FUNCTIONAL_SPEC.md: type whitelist + size limit.
MAX_UPLOAD_BYTES=26214400   # 25 MB
ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# ---- Async jobs ----
# "inline" runs the job in the request process (dev default, no broker needed).
# "rq" uses Redis + RQ/Celery as allowed by docs/README.md.
JOB_BACKEND=inline
REDIS_URL=redis://127.0.0.1:6379/0

# ---- AI / OCR providers ----
# Provider abstraction (docs/04_TECH_ARCHITECTURE.md). Business code must not
# import vendor SDKs directly — only app.ai.providers.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
OCR_PROVIDER=mock
OCR_API_KEY=
# Every AI result stores provider/model/prompt_version (docs/07_AI_PIPELINE.md).
PROMPT_VERSION=evidence-extraction-v1

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ---- CORS ----
# Comma-separated browser origins allowed to call the API. allow_credentials is
# intentionally off: the frontend sends the JWT via the Authorization header
# (localStorage), never cookies, so no credentialed CORS is needed.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
